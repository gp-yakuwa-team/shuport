// https://aka.ms/devcontainer.json
{
	"name": "ShuPort (Sail + Claude Code)",
	"dockerComposeFile": [
		"../compose.yaml",
		"compose.claude.yaml"
	],
	"service": "laravel.test",
	"workspaceFolder": "/var/www/html",
	"initializeCommand": "docker compose build laravel.test",
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code"
			],
			"settings": {}
		}
	},
	"remoteUser": "sail",
	"remoteEnv": {
		"PATH": "/home/sail/.local/bin:${containerEnv:PATH}"
	},
	"postCreateCommand": "curl -fsSL https://claude.ai/install.sh -o /tmp/install-claude.sh && bash /tmp/install-claude.sh"
}
